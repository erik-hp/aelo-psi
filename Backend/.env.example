DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
CLINICAL_DATA_KEYS=replace-with-base64-of-32-random-bytes
AUDIT_LOG_HMAC_KEY=replace-with-an-independent-random-hmac-key
CLINICAL_RETENTION_DAYS=0
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_REQUIRE_HTTPS=False
DJANGO_HSTS_SECONDS=0
AELO_DOMAIN=your-domain.example
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=aelo
POSTGRES_USER=aelo
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
DRF_ANON_THROTTLE=60/hour
DRF_USER_THROTTLE=1000/hour
DRF_LOGIN_THROTTLE=10/minute
DRF_AI_THROTTLE=30/hour

AELO_ENABLE_DJANGO_ADMIN=False
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT=90
AI_SERVICE_TOKEN=replace-with-a-long-random-service-token
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=embeddinggemma
RAG_TOP_K=5
# Increase together with the host memory; prompts above this limit fail explicitly.
OLLAMA_NUM_CTX=8192
# Layered retrieval (ADR-003) stays disabled until that decision is approved.
AI_LOD_RETRIEVAL=False
AI_LOD_MAX_REMOTE_NOTES=2
AI_LOD_SOURCE_SEARCH=True
# Test engine, synthetic notes only (ADR-004). See docs/OPERATIONS.md.
AI_ENGINE=ollama
# Automatic note reading: only with synthetic data, and refused in HTTPS deployments.
AI_AUTO_EXTRACTION=False
AELO_SYNTHETIC_DATA_ONLY=False
